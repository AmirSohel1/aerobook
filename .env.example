# ==============================================================================
# AeroBook Cloud Platform - Environment Configuration Template (.env.example)
# Copy this file to .env and configure real credentials for production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Credentials (MySQL 8.x)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# Microservice Databases
AUTH_DB_NAME=aerobook_auth_db
USER_DB_NAME=aerobook_user_db
FLIGHT_DB_NAME=aerobook_flight_db
BOOKING_DB_NAME=aerobook_booking_db
FARE_DB_NAME=aerobook_fare_db
CHECKIN_DB_NAME=aerobook_checkin_db
NOTIFICATION_DB_NAME=aerobook_notification_db
PAYMENT_DB_NAME=aerobook_payment_db

# ------------------------------------------------------------------------------
# 2. Security & JWT Configuration
# ------------------------------------------------------------------------------
# 256-bit (or 512-bit) Base64 encoded secret for HMAC-SHA signing
JWT_SECRET=your_base64_encoded_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Test Mode / Production)
# ------------------------------------------------------------------------------
# Key ID is public and can be passed to frontend checkout options
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
# Key Secret MUST remain private on the backend payment-service
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_must_stay_private
# Webhook Secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. SMTP Email Service (Notification Service)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@aerobook.internal
SPRING_MAIL_PASSWORD=your_smtp_app_password_here
SPRING_MAIL_FROM=no-reply@aerobook.internal
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ------------------------------------------------------------------------------
# 5. Service Ports Topology
# ------------------------------------------------------------------------------
EUREKA_PORT=8761
GATEWAY_PORT=8083
AUTH_SERVICE_PORT=8082
USER_SERVICE_PORT=8084
FLIGHT_SERVICE_PORT=8087
BOOKING_SERVICE_PORT=8088
FARE_SERVICE_PORT=8089
CHECKIN_SERVICE_PORT=8090
NOTIFICATION_SERVICE_PORT=8091
PAYMENT_SERVICE_PORT=8092
FRONTEND_PORT=4200
