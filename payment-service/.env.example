# Payment Service Environment Template
SERVER_PORT=8092
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aerobook_payment_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_placeholder_key_secret_keep_private
RAZORPAY_WEBHOOK_SECRET=your_placeholder_webhook_secret
