# Notification Service Environment Template
SERVER_PORT=8091
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aerobook_notification_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# SMTP Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@aerobook.internal
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_FROM=no-reply@aerobook.internal
